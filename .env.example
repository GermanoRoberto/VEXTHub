# VextHub web
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Required for endpoint agents and installer ZIP generation.
# Use at least 24 random characters, preferably 32+.
AGENT_SHARED_SECRET=replace-with-strong-random-agent-secret

# VextHub API service
DATABASE_URL=postgresql://vexthub:vexthub@localhost:5432/vexthub
REDIS_URL=redis://localhost:6379/0
API_INTERNAL_TOKEN=replace-with-strong-random-api-token
WEBHOOK_SIGNING_SECRET=replace-with-strong-random-webhook-secret
CORS_ORIGINS=http://localhost:3000
APP_BASE_URL=https://vexthub.example.com

# Optional local-only development portal.
# Enabled automatically in npm run dev; set true only in controlled test environments.
VEXTHUB_DEV_PORTAL=false

# Optional AI enrichment for defensive triage.
# The local rule engine works without this and remains the source of truth.
VEXTHUB_AI_ENABLED=false
VEXTHUB_AI_PROVIDER=gemini
VEXTHUB_AI_MODEL=gemini-2.0-flash
VEXTHUB_AI_TIMEOUT_MS=3500

# Gemini provider. Either variable is accepted.
GEMINI_API_KEY=
VEXTHUB_GEMINI_API_KEY=

# Groq provider. Set VEXTHUB_AI_PROVIDER=groq and, optionally,
# VEXTHUB_AI_MODEL=llama-3.3-70b-versatile.
GROQ_API_KEY=
VEXTHUB_GROQ_API_KEY=

# Optional override for Gemini/Groq base URL.
VEXTHUB_AI_BASE_URL=

# Legacy/custom defensive endpoint compatible with the previous OpenCloud-style flow.
# Set VEXTHUB_AI_PROVIDER=opencloud-compatible to use it.
VEXTHUB_AI_ENDPOINT=
VEXTHUB_AI_API_KEY=
